    "historyWindOfs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capcost", "fom", "vom", "cf_improvement", "rsc_mult"],
      "properties": {
        "capcost": {"oneOf": [{"$ref": "#/definitions/historyMode"}, {"$ref": "#/definitions/historyModeByWindOfs"}]},
        "fom": {"oneOf": [{"$ref": "#/definitions/historyMode"}, {"$ref": "#/definitions/historyModeByWindOfs"}]},
        "vom": {"oneOf": [{"$ref": "#/definitions/historyModeWithoutReal"}, {"$ref": "#/definitions/historyModeByWindOfsNoReal"}]},
        "cf_improvement": {"oneOf": [{"$ref": "#/definitions/historyMode"}, {"$ref": "#/definitions/historyModeByWindOfs"}]},
        "rsc_mult": {"oneOf": [{"enum": ["reeds_baseline", "backfill"]}, {"$ref": "#/definitions/historyModeByWindOfsNoReal"}]}
      }
    },
    "futureDataByWindOfs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed", "floating"],
      "properties": {
        "fixed": {"$ref": "#/definitions/atbFutureData"},
        "floating": {"$ref": "#/definitions/atbFutureData"}
      }
    },
    "technologyWindOfs": {
      "allOf": [
        {"$ref": "#/definitions/technologyConfigBase"},
        {
          "properties": {
            "historical_data": {"$ref": "#/definitions/historyWindOfs"},
            "future_data": {"$ref": "#/definitions/futureDataByWindOfs"}
          }
        }
      ]
    },
