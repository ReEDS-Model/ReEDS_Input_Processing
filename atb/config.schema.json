      "required": ["capcost", "fom", "vom", "cf_improvement"],
      "properties": {
        "capcost": {"oneOf": [{"$ref": "#/definitions/historyMode"}, {"$ref": "#/definitions/historyModeByWindOns"}]},
        "fom": {"oneOf": [{"$ref": "#/definitions/historyMode"}, {"$ref": "#/definitions/historyModeByWindOns"}]},
        "vom": {"oneOf": [{"$ref": "#/definitions/historyModeWithoutReal"}, {"$ref": "#/definitions/historyModeByWindOnsNoReal"}]},
        "cf_improvement": {"oneOf": [{"$ref": "#/definitions/historyMode"}, {"$ref": "#/definitions/historyModeByWindOns"}]}
      }
    },
    "futureDataByWindOns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["115hh_170rd"],
      "properties": {
        "115hh_170rd": {"$ref": "#/definitions/atbFutureData"}
      }
    },
    "technologyWindOns": {
      "allOf": [
        {"$ref": "#/definitions/technologyConfigBase"},
        {
          "properties": {
            "historical_data": {"$ref": "#/definitions/historyWindOns"},
            "future_data": {"$ref": "#/definitions/futureDataByWindOns"}
          }
        }
      ]
    },
    "historyModeByWindOfs": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "One history mode per wind-ofs sub-technology; classes without an observed series cannot select real.",
      "properties": {
        "fixed": {"$ref": "#/definitions/historyMode"},
        "floating": {"$ref": "#/definitions/historyModeWithoutReal"}
      }
    },
    "historyModeByWindOfsNoReal": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "One history mode per wind-ofs sub-technology; used by metrics that never offer real.",
      "properties": {
        "fixed": {"$ref": "#/definitions/historyModeWithoutReal"},
